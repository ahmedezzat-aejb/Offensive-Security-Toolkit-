import os
import re
import sys

PATTERNS = {
    "AWS Access Key": r"AKIA[0-9A-Z]{16}",
    "Google API Key": r"AIza[0-9A-Za-z\-_]{35}",
    "Generic Secret/Token": r"(?i)(api_key|secret_key|password|auth_token)\s*[:=]\s*['\"][a-zA-Z0-9_\-]{8,}['\"]",
    "Firebase URL": r"https://[a-z0-9-]+\.firebaseio\.com"
}

def scan_directory(target_dir):
    print(f"[*] Scanning directory for hardcoded secrets: {target_dir}\n")
    for root, _, files in os.walk(target_dir):
        for file in files:
            if file.endswith(('.java', '.kt', '.xml', '.json', '.js', '.py')):
                filepath = os.path.join(root, file)
                try:
                    with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                        content = f.read()
                        for name, pattern in PATTERNS.items():
                            matches = re.findall(pattern, content)
                            if matches:
                                print(f"[!] {name} found in {filepath}")
                except Exception:
                    pass

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 secret_scanner.py <source_code_directory>")
    else:
        scan_directory(sys.argv[1])
